{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "shivamsingh.dev" }],
      "destination": "https://www.shivamsingh.dev/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "shivamsingh.dev" }],
      "destination": "https://www.shivamsingh.dev/:path+",
      "permanent": true
    }
  ]
}
